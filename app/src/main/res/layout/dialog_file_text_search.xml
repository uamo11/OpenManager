<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="400dp"
    android:background="#1E1E1E">

    <!-- 1. SETUP VIEW -->
    <ScrollView
        android:id="@+id/layoutSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/om_fts_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSetupPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="/storage/emulated/0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E2E2E"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Search Query Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/om_fts_query_label"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editSearchQuery"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="#282828"
                android:hint="@string/om_fts_query_hint"
                android:textColorHint="#6E7681"
                android:textColor="#F0F6FC"
                android:textSize="13.5sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true" />

            <!-- Replace Text Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/om_fts_replace_label"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editReplaceQuery"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="#282828"
                android:hint="@string/om_fts_replace_hint"
                android:textColorHint="#6E7681"
                android:textColor="#F0F6FC"
                android:textSize="13.5sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true" />

            <!-- Options Checkboxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/cbCaseSensitive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/om_fts_case_sensitive"
                    android:textColor="#F0F6FC"
                    android:textSize="12sp"
                    android:buttonTint="#58A6FF" />

                <CheckBox
                    android:id="@+id/cbWholeWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/om_fts_whole_word"
                    android:textColor="#F0F6FC"
                    android:textSize="12sp"
                    android:buttonTint="#58A6FF" />

                <CheckBox
                    android:id="@+id/cbRegex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/om_fts_regex"
                    android:textColor="#F0F6FC"
                    android:textSize="12sp"
                    android:buttonTint="#58A6FF" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbRecursive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/om_fts_recursive"
                android:checked="true"
                android:textColor="#F0F6FC"
                android:textSize="12sp"
                android:buttonTint="#58A6FF" />

            <!-- Extension Filter -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/om_fts_ext_filter"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editExtensionFilter"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="#282828"
                android:hint="@string/om_fts_ext_hint"
                android:textColorHint="#6E7681"
                android:textColor="#F0F6FC"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true" />

            <!-- Quick Extension Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipExtAll"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_terminal_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/om_fts_ext_all"
                        android:textColor="#58A6FF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipExtXml"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_terminal_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=".xml"
                        android:textColor="#C9D1D9"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipExtSmali"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_terminal_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=".smali"
                        android:textColor="#C9D1D9"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipExtCode"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_terminal_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=".java, .kt"
                        android:textColor="#C9D1D9"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipExtJson"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_terminal_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=".json, .txt"
                        android:textColor="#C9D1D9"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/om_fts_search_btn"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F6FEB"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 2. SCANNING PROGRESS VIEW -->
    <LinearLayout
        android:id="@+id/layoutScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#1F6FEB"
            app:trackColor="#282828" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/om_fts_searching"
            android:textColor="#F0F6FC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanningProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="@string/om_scanning" />
    </LinearLayout>

    <!-- 3. RESULTS VIEW -->
    <LinearLayout
        android:id="@+id/layoutResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Summary Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#282828"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvResultsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 coincidencias en 7 archivos"
                android:textColor="#F0F6FC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultsSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#8B949E"
                android:textSize="11.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Selection Pills -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_terminal_hud_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/om_action_select_all"
                    android:textColor="#58A6FF"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnDeselectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_terminal_hud_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/om_action_deselect_all"
                    android:textColor="#C9D1D9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnInvertSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_terminal_hud_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/om_action_invert"
                    android:textColor="#C9D1D9"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Matches RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMatches"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- Replace Action Buttons (Supporting "algunas palabras" or "todas las palabras") -->
        <LinearLayout
            android:id="@+id/layoutReplaceActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Replace in Selected Files ("algunas palabras") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceSelected"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/om_fts_replace_selected"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#238636"
                app:cornerRadius="8dp" />

            <!-- Replace in All Files ("todas las palabras") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/om_fts_replace_all"
                android:textStyle="bold"
                android:textSize="11.5sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F6FEB"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
