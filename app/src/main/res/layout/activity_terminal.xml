<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTerminal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        app:elevation="0dp">

        <!-- 1. Workstation MaterialToolbar with Monospace Title, Live Runtime Subtitle & Action Icons -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/arrow_back_icon_white_24dp"
            app:title="@string/terminal_title"
            app:titleTextColor="#F0F6FC"
            app:subtitleTextColor="#8B949E">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/btnStopSession"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_terminal_stop_24dp"
                    app:tint="#F85149"
                    android:contentDescription="@string/om_term_stop_signal" />

                <ImageButton
                    android:id="@+id/btnScriptAudit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/shield_icon_white_24dp"
                    app:tint="#58A6FF"
                    android:contentDescription="@string/script_audit_title" />

                <ImageButton
                    android:id="@+id/btnCopyScreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/copy_icon_control_normal_24dp"
                    app:tint="#C9D1D9"
                    android:contentDescription="@string/om_terminal_copy_output" />

                <ImageButton
                    android:id="@+id/btnDeadManSkull"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_dead_man_skull"
                    app:tint="#F85149"
                    android:contentDescription="@string/dead_man_skull_button_desc" />

                <ImageButton
                    android:id="@+id/btnOverflowMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/more_vertical_icon_white_24dp"
                    app:tint="#C9D1D9"
                    android:contentDescription="@string/om_more_options" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 2. Workstation Session HUD Strip: [● SH ▾]  [ 📁 ~/sdcard ]  [ − | 14sp | + ] -->
        <LinearLayout
            android:id="@+id/layoutTerminalHud"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#121720"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- Interactive Environment & Status Capsule -->
            <LinearLayout
                android:id="@+id/layoutSessionBadge"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_terminal_hud_pill"
                android:paddingStart="9dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="14dp"
                    android:layout_height="14dp">

                    <View
                        android:id="@+id/viewSessionDotHalo"
                        android:layout_width="14dp"
                        android:layout_height="14dp" />

                    <View
                        android:id="@+id/viewSessionDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSessionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="SH"
                    android:textColor="#86EFAC"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvSessionChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="▾"
                    android:textColor="#8B949E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Recessed Tap-to-Copy Working Directory Chip -->
            <LinearLayout
                android:id="@+id/layoutCwdChip"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCwdFolder"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/directory_icon_white_24dp"
                    app:tint="#8B949E"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvTerminalBreadcrumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="~/sdcard"
                    android:textColor="#C9D1D9"
                    android:textSize="11.5sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Segmented Font-Size Stepper Pill -->
            <LinearLayout
                android:id="@+id/layoutZoomPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_terminal_zoom_capsule"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnZoomOut"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#C9D1D9"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/om_terminal_decrease_font" />

                <View
                    android:id="@+id/viewZoomDivLeft"
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:background="#30363D" />

                <TextView
                    android:id="@+id/tvZoomSize"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="7dp"
                    android:gravity="center"
                    android:text="14sp"
                    android:textColor="#58A6FF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/om_terminal_reset_font" />

                <View
                    android:id="@+id/viewZoomDivRight"
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:background="#30363D" />

                <TextView
                    android:id="@+id/btnZoomIn"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#C9D1D9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/om_terminal_increase_font" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/viewHudBottomDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 3. Terminal Canvas Monitor Frame -->
    <FrameLayout
        android:id="@+id/terminalContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D1117">

        <com.termux.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#000000"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Brings the hidden extra-keys deck back -->
        <TextView
            android:id="@+id/btnShowExtraKeys"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_terminal_dead_man_badge"
            android:backgroundTint="#CC1B2230"
            android:contentDescription="@string/om_term_keys_layout"
            android:elevation="4dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Floating Dead Man Alert Capsule -->
        <LinearLayout
            android:id="@+id/layoutDeadManAlertBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            android:background="@drawable/bg_terminal_dead_man_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dead_man_skull"
                app:tint="#FF7B72"
                android:contentDescription="Dead Man" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/om_terminal_deadman_locked"
                android:textColor="#FFDCD7"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </FrameLayout>

    <!-- Remote session one-tap shortcuts (SSH/Telnet profiles) -->
    <HorizontalScrollView
        android:id="@+id/remoteShortcutsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/remoteShortcutsContainer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <!-- Local writing bar: compose with the keyboard (no network round trip per key), send at once -->
    <LinearLayout
        android:id="@+id/composeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10141C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/composeInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/remote_section_bar_background"
            android:hint="@string/om_term_compose_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/composeSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/om_term_compose_send"
            android:src="@drawable/ic_compose_send_24dp"
            app:tint="#58A6FF" />
    </LinearLayout>

    <!-- 4. Tactile Workstation Extra Keys Deck -->
    <me.zhanghai.android.files.terminal.TerminalExtraKeysView
        android:id="@+id/extraKeysView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10141C" />

</LinearLayout>
