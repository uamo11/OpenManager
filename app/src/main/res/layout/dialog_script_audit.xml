<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ivAuditIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/shield_icon_white_24dp"
                app:tint="#64B5F6"
                android:contentDescription="@string/script_audit_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvAuditTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/script_audit_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvAuditScriptPath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/storage/emulated/0/script.sh"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorSecondary"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAuditStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN EJECUCIÓN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="#1B5E20" />
        </LinearLayout>

        <!-- Static Script Audit Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStaticAudit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#333333"
            app:cardBackgroundColor="#212121">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStaticAuditTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/script_audit_static_card_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvStaticAuditBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMPIO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#81C784"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="#1B5E20" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStaticAuditDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/script_audit_static_clean_desc"
                    android:textSize="11sp"
                    android:textColor="#B0BEC5"
                    android:layout_marginTop="4dp" />

                <!-- Categories Container -->
                <LinearLayout
                    android:id="@+id/layoutStaticAuditCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <!-- Button to view highlighted code -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAuditCode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/script_audit_btn_view_flagged_lines"
                    android:textColor="#64B5F6"
                    app:strokeColor="#42A5F5"
                    app:icon="@drawable/shield_icon_white_24dp"
                    app:iconTint="#64B5F6"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Configuration Card (Switch & Deletion Policy) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#333333"
            app:cardBackgroundColor="#212121">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Enable/Disable Tracer Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/script_audit_enable_tracer"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/script_audit_enable_tracer_desc"
                            android:textSize="11sp"
                            android:textColor="#B0BEC5"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEnableTracer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333"
                    android:layout_marginVertical="10dp" />

                <!-- Deletion Policy Radio Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/script_audit_deletion_policy"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#90CAF9"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgDeletionPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPolicyAsk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/script_audit_policy_ask"
                        android:textSize="12sp"
                        android:textColor="#E0E0E0" />

                    <RadioButton
                        android:id="@+id/rbPolicyBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/script_audit_policy_block"
                        android:textSize="12sp"
                        android:textColor="#EF9A9A" />

                    <RadioButton
                        android:id="@+id/rbPolicyAllow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/script_audit_policy_allow"
                        android:textSize="12sp"
                        android:textColor="#A5D6A7" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Grid (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <!-- Card 1: Deletions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#262626"
                app:strokeWidth="1dp"
                app:strokeColor="#383838">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑️ Borrados"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5" />

                    <TextView
                        android:id="@+id/tvStatDeletionsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#EF5350"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatDeletionsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 bloq • 0 perm"
                        android:textSize="10sp"
                        android:textColor="#78909C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Syscalls -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#262626"
                app:strokeWidth="1dp"
                app:strokeColor="#383838">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Syscalls"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5" />

                    <TextView
                        android:id="@+id/tvStatSyscallsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#64B5F6"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatSyscallsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frecuencia normal"
                        android:textSize="10sp"
                        android:textColor="#78909C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card 3: Kernel / Proc -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#262626"
                app:strokeWidth="1dp"
                app:strokeColor="#383838">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 Kernel / Proc"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5" />

                    <TextView
                        android:id="@+id/tvStatKernelVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFB74D"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatKernelSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultas /proc"
                        android:textSize="10sp"
                        android:textColor="#78909C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Dead Man -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#262626"
                app:strokeWidth="1dp"
                app:strokeColor="#383838">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💀 Dead Man"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5" />

                    <TextView
                        android:id="@+id/tvStatDeadManVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#81C784"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatDeadManSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wipe guard ON"
                        android:textSize="10sp"
                        android:textColor="#78909C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Events Section Header & Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/script_audit_history_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnCopyAuditLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/script_audit_btn_copy"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#64B5F6"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnClearAuditLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/script_audit_btn_clear"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#EF5350"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Empty State Message -->
        <TextView
            android:id="@+id/tvEmptyEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/script_audit_empty"
            android:textSize="12sp"
            android:textColor="#78909C"
            android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:padding="16dp"
            android:background="#1E1E1E" />

        <!-- Dynamic Events Container -->
        <LinearLayout
            android:id="@+id/layoutEventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
