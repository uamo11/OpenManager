<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#303030">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Octal & Mode Representation at Top/Center: rwxrwxrwx ( [ 777 ] ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="#222222"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/modeStringText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rwxrwxrwx"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="("
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E" />

                <EditText
                    android:id="@+id/octalEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:digits="01234567"
                    android:maxLength="4"
                    android:selectAllOnFocus="true"
                    android:text="777"
                    android:fontFamily="monospace"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#64B5F6"
                    android:backgroundTint="#64B5F6"
                    android:background="?attr/editTextBackground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=")"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E" />
            </LinearLayout>

            <!-- Quick Octal Presets Row (MT Manager style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreset777"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#3D3D3D"
                    android:gravity="center"
                    android:text="777"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#81C784"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPreset755"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#3D3D3D"
                    android:gravity="center"
                    android:text="755"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#64B5F6"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPreset644"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#3D3D3D"
                    android:gravity="center"
                    android:text="644"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnPreset600"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#3D3D3D"
                    android:gravity="center"
                    android:text="600"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FFB74D"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Permissions 3x3 Table Layout matching MT Manager -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2,3">

                <!-- Header Row -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/file_properties_permission_set_mode_read"
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:textColor="#BDBDBD" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/file_properties_permission_set_mode_write"
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:textColor="#BDBDBD" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/file_properties_permission_set_mode_exec"
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:textColor="#BDBDBD" />
                </TableRow>

                <!-- Owner Row -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/file_properties_permission_owner"
                        android:textColor="#FFFFFF"
                        android:textAppearance="?textAppearanceSubtitle1" />

                    <CheckBox
                        android:id="@+id/ownerReadCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/ownerWriteCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/ownerExecCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />
                </TableRow>

                <!-- Group Row -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/file_properties_permission_group"
                        android:textColor="#FFFFFF"
                        android:textAppearance="?textAppearanceSubtitle1" />

                    <CheckBox
                        android:id="@+id/groupReadCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/groupWriteCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/groupExecCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />
                </TableRow>

                <!-- Other Row -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/file_properties_permission_set_mode_others"
                        android:textColor="#FFFFFF"
                        android:textAppearance="?textAppearanceSubtitle1" />

                    <CheckBox
                        android:id="@+id/otherReadCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/otherWriteCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />

                    <CheckBox
                        android:id="@+id/otherExecCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:buttonTint="#64B5F6"
                        android:layout_gravity="center" />
                </TableRow>
            </TableLayout>

            <!-- Special Permissions Section Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/file_properties_permission_special_header"
                android:textAppearance="?textAppearanceCaption"
                android:textColor="#9E9E9E" />

            <!-- Special Permissions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/setUidCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#64B5F6"
                    android:textColor="#E0E0E0"
                    android:text="Set UID" />

                <CheckBox
                    android:id="@+id/setGidCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:buttonTint="#64B5F6"
                    android:textColor="#E0E0E0"
                    android:text="Set GID" />

                <CheckBox
                    android:id="@+id/stickyCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:buttonTint="#64B5F6"
                    android:textColor="#E0E0E0"
                    android:text="Sticky" />
            </LinearLayout>

            <!-- Recursive options for directory -->
            <CheckBox
                android:id="@+id/recursiveCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="-7dp"
                android:paddingStart="@dimen/dialog_padding_minus_7dp"
                app:buttonTint="#64B5F6"
                android:textColor="#E0E0E0"
                android:text="@string/file_properties_permission_recursive"
                android:textAppearance="?textAppearanceListItem" />

            <CheckBox
                android:id="@+id/uppercaseXCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-7dp"
                android:paddingStart="@dimen/dialog_padding_minus_7dp"
                app:buttonTint="#64B5F6"
                android:textColor="#E0E0E0"
                android:text="@string/file_properties_permission_set_mode_uppercase_x"
                android:textAppearance="?textAppearanceListItem" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
