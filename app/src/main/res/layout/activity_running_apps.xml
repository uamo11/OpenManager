<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F1F1F"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1F1F1F"
            app:title="@string/running_apps_title"
            app:titleTextColor="#FFFFFF" />

        <!-- RAM Memory Monitor Card (App Manager Style) -->
        <LinearLayout
            android:id="@+id/cardRamMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:background="#191919">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRamUsageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="RAM: 2.8 GB / 6.0 GB (46%)" />

                <TextView
                    android:id="@+id/tvElevationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_category_pill"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="ROOT" />

                <TextView
                    android:id="@+id/tvRamAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="3.2 GB disponible" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbRamUsage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="46"
                android:progressTint="#00E676"
                android:progressBackgroundTint="#333333" />

            <TextView
                android:id="@+id/tvProcessCounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp"
                tools:text="182 procesos en ejecución • 28 aplicaciones activas" />
        </LinearLayout>

        <!-- Permission Banner when Unprivileged (App Manager Style) -->
        <LinearLayout
            android:id="@+id/cardPermissionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="#241B08"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivBannerIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/shield_icon_white_24dp"
                    app:tint="#FFA000" />

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="#FFA000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/running_apps_permission_banner_title" />

                <ImageButton
                    android:id="@+id/btnDismissBanner"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/close_icon_control_normal_24dp"
                    android:contentDescription="@string/close"
                    app:tint="#FFA000" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBannerMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFE082"
                android:textSize="11.5sp"
                android:text="@string/running_apps_permission_banner_msg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBannerRequestRoot"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/running_apps_action_request_root"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:icon="@drawable/shield_icon_white_24dp"
                    app:iconSize="15dp"
                    android:backgroundTint="#C62828"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBannerRequestShizuku"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="@string/running_apps_action_request_shizuku"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_shizuku"
                    app:iconSize="15dp"
                    android:backgroundTint="#0277BD"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs: Usuario | Sistema | Todos -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1F1F1F"
            app:tabIndicatorColor="#00E676"
            app:tabIndicatorHeight="2.5dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="#00E676"
            app:tabTextColor="#9E9E9E" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Running Apps RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_running_apps"
            android:drawablePadding="12dp"
            android:text="@string/running_apps_empty"
            android:textColor="#757575"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E676" />
    </FrameLayout>

    <!-- Floating Action Button: Refresh Running Apps -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Refrescar"
        android:src="@drawable/reset_icon_white_24dp"
        app:backgroundTint="#00E676"
        app:tint="#121212" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
