<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <me.zhanghai.android.files.ui.CoordinatorAppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/scrollView">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="?actionBarPopupTheme" />

        <!-- MT Manager Style Status Info Strip directly below toolbar -->
        <LinearLayout
            android:id="@+id/editorStatusStrip"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#181A1F">

            <TextView
                android:id="@+id/statusFileNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textSize="11.5sp"
                android:textColor="#ABB2BF"
                android:textStyle="bold"
                tools:text="*test.cpp" />

            <TextView
                android:id="@+id/statusCursorPosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="#61AFEF"
                android:fontFamily="monospace"
                android:background="?selectableItemBackgroundBorderless"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="122:46" />

            <TextView
                android:id="@+id/statusSelectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textColor="#E5C07B"
                android:fontFamily="monospace"
                android:visibility="gone"
                tools:text="[Sel: 12]"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/statusEncodingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11.5sp"
                android:textColor="#98C379"
                android:background="?selectableItemBackgroundBorderless"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="UTF-8" />

            <TextView
                android:id="@+id/statusLineEndingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11.5sp"
                android:textColor="#E5C07B"
                android:background="?selectableItemBackgroundBorderless"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="LF" />

            <TextView
                android:id="@+id/statusSyntaxText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11.5sp"
                android:textColor="#C678DD"
                android:background="?selectableItemBackgroundBorderless"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                tools:text="C++" />
        </LinearLayout>
    </me.zhanghai.android.files.ui.CoordinatorAppBarLayout>

    <me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Main Editor Workspace -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="32dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?textAppearanceListItem"
                    android:visibility="gone"
                    app:drawableTopCompat="@drawable/error_icon_240dp" />

                <LinearLayout
                    android:id="@+id/editorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:background="#1E1E1E">

                    <me.zhanghai.android.files.viewer.text.LineNumberView
                        android:id="@+id/lineNumberView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />

                    <me.zhanghai.android.fastscroll.FastScrollNestedScrollView
                        android:id="@+id/scrollView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:fillViewport="true">

                        <HorizontalScrollView
                            android:id="@+id/horizontalScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <me.zhanghai.android.files.viewer.text.CodeEditText
                                android:id="@+id/textEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="48dp"
                                android:background="@null"
                                android:gravity="top"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:textColor="#DCDFE4"
                                android:textSize="14sp">
                                <requestFocus />
                            </me.zhanghai.android.files.viewer.text.CodeEditText>
                        </HorizontalScrollView>
                    </me.zhanghai.android.fastscroll.FastScrollNestedScrollView>
                </LinearLayout>

                <!-- Floating Zoom HUD -->
                <TextView
                    android:id="@+id/zoomIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_zoom_indicator"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:elevation="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="14.0 sp (100%)" />
            </FrameLayout>

            <!-- Search & Replace Panel (MT Manager Style at Bottom above Keyboard) -->
            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#21252B"
                android:elevation="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Top Info and Options Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/searchCountText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#E5C07B"
                        tools:text="Resultados: 0" />

                    <!-- Cc: Match Case -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchCaseBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="38dp"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="Cc"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#DCDFE4" />

                    <!-- W: Whole Word -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchWordBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="38dp"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="W"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#DCDFE4" />

                    <!-- .*: Regex -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchRegexBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="38dp"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text=".*"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#DCDFE4" />
                </LinearLayout>

                <!-- Search Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_editor_search"
                        android:textSize="13sp"
                        android:textColor="#ABB2BF" />

                    <EditText
                        android:id="@+id/searchEdit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:hint="@string/text_editor_search_hint"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:background="@drawable/search_input_background"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#DCDFE4"
                        android:textColorHint="#5C6370" />

                    <ImageButton
                        android:id="@+id/searchClearBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/close_icon_control_normal_24dp"
                        android:contentDescription="@string/clear"
                        app:tint="#ABB2BF" />
                </LinearLayout>

                <!-- Replace Input Row -->
                <LinearLayout
                    android:id="@+id/replaceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_editor_replace_label"
                        android:textSize="13sp"
                        android:textColor="#ABB2BF" />

                    <EditText
                        android:id="@+id/replaceEdit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:hint="@string/text_editor_replace_hint"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:inputType="textNoSuggestions"
                        android:background="@drawable/search_input_background"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#DCDFE4"
                        android:textColorHint="#5C6370" />

                    <ImageButton
                        android:id="@+id/replaceClearBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/close_icon_control_normal_24dp"
                        android:contentDescription="@string/clear"
                        app:tint="#ABB2BF" />
                </LinearLayout>

                <!-- Bottom Actions Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchPrevBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/text_editor_search_previous_caps"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#61AFEF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchNextBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/text_editor_search_next_caps"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#61AFEF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/replaceBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/text_editor_replace_caps"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#61AFEF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/replaceAllBtn"
                        style="?borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/text_editor_replace_all_caps"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#61AFEF" />

                    <ImageButton
                        android:id="@+id/searchCloseBtn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/close_icon_control_normal_24dp"
                        android:contentDescription="@string/close"
                        app:tint="#61AFEF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Symbol & Navigation Bar -->
            <HorizontalScrollView
                android:id="@+id/symbolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="#1E1E1E"
                android:elevation="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/symbolContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
