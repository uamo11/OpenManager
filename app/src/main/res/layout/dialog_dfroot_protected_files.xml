<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/categoriesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_root_dfroot"
                android:contentDescription="DFROOT" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DirtyFlag Protection"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvHeaderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTECCIÓN ACTIVA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="En entornos con DFRoot, DirtyFlag o bootloader bloqueado, modificar, reemplazar, renombrar o cambiar permisos a los archivos clasificados a continuación causará un brick o bootloop irrecuperable al reiniciar el teléfono." />

        <!-- Dynamic Category Views will be inserted into categoriesContainer -->

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
