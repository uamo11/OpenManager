<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/layoutHubCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Section 1 Header: Visual Theme + Accent Color Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHubThemeHeaderIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_palette_swatch_24dp" />

            <TextView
                android:id="@+id/tvHubThemeHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_hub_theme_title"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnHubAccent"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="10dp">

                <View
                    android:id="@+id/viewHubAccentDot"
                    android:layout_width="11dp"
                    android:layout_height="11dp" />

                <TextView
                    android:id="@+id/tvHubAccentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/settings_hub_accent_chip"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4 Quick Theme Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileThemeLight"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/ivTileThemeLight"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_day_mode_24dp" />

                <TextView
                    android:id="@+id/tvTileThemeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_theme_light"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileThemeDark"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/ivTileThemeDark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_night_mode_24dp" />

                <TextView
                    android:id="@+id/tvTileThemeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_theme_dark"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileThemeAmoled"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/ivTileThemeAmoled"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_amoled_oled_24dp" />

                <TextView
                    android:id="@+id/tvTileThemeAmoled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_theme_amoled"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileThemeSystem"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/ivTileThemeSystem"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/device_icon_white_24dp" />

                <TextView
                    android:id="@+id/tvTileThemeSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_theme_system"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section Divider -->
        <View
            android:id="@+id/viewHubDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="12dp" />

        <!-- Section 2 Header: Thumbnails & Scroll Engine + Live Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHubPerfHeaderIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_perf_bolt_24dp" />

            <TextView
                android:id="@+id/tvHubPerfHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_hub_perf_title"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHubPerfStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="@string/settings_hub_status_standard"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3 Thumbnail Engine Mode Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileThumbFull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivTileThumbFull"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/image_icon_white_24dp" />

                <TextView
                    android:id="@+id/tvTileThumbFull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_full"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileThumbFullSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_full_sub"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileThumbOptimized"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivTileThumbOptimized"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_perf_bolt_24dp" />

                <TextView
                    android:id="@+id/tvTileThumbOptimized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_opt"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileThumbOptimizedSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_opt_sub"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileThumbVector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="70dp"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivTileThumbVector"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_vector_shapes_24dp" />

                <TextView
                    android:id="@+id/tvTileThumbVector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_vec"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileThumbVectorSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_thumb_vec_sub"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Quick Toggle: UI Turbo Mode -->
        <LinearLayout
            android:id="@+id/rowHubTurbo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/ivHubTurboIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_perf_bolt_24dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHubTurboTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_turbo_title"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHubTurboSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_hub_turbo_subtitle_off"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchHubTurbo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
