<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ OpenManager - MT-Style Dual Pane Activity Layout
  ~ Unified Top Toolbar, Split Panels, MT-Style Bottom Bar, and Activity DrawerLayout.
  -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Activity Main Content -->
    <LinearLayout
        android:id="@+id/activityRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:fitsSystemWindows="false">

        <!-- 1. Top Unified MT-Style Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:background="#151515"
            app:navigationIcon="@drawable/menu_icon_control_normal_24dp"
            app:navigationIconTint="@android:color/white"
            app:navigationContentDescription="@string/open_navigation_drawer"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMainBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_vertical"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_back_icon_white_24dp"
                    android:contentDescription="@string/file_list_action_navigate_up"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:id="@+id/layoutPathTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?selectableItemBackground"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvPathTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="/storage/emulated/0/" />

                    <TextView
                        android:id="@+id/tvStatsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="10sp"
                        android:textColor="#A0A0A0"
                        android:text="@string/om_loading_dots" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMainMore"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/more_vertical_icon_white_24dp"
                    android:contentDescription="@string/om_more_options"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 2. Panels Container (Horizontal Split for Dual Pane) -->
        <LinearLayout
            android:id="@+id/panelsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <me.zhanghai.android.files.ui.ExactFrameLayout
                android:id="@+id/containerPanelA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#363636" />

            <View
                android:id="@+id/paneDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#1D1D1D" />

            <me.zhanghai.android.files.ui.ExactFrameLayout
                android:id="@+id/containerPanelB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#242424" />
        </LinearLayout>

        <!-- 3. MT-Style Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:gravity="top"
            android:background="#202020">

            <!-- Normal Mode: [<] [>] [+] [⇆] [↑] -->
            <LinearLayout
                android:id="@+id/bottomBarNormal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBottomBack"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_back_chevron_white_24dp"
                    android:contentDescription="@string/om_action_back"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomForward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_forward_chevron_white_24dp"
                    android:contentDescription="@string/om_action_forward"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomAdd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/add_icon_white_24dp"
                    android:contentDescription="@string/om_action_new"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomSwap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mt_swap"
                    android:contentDescription="@string/om_action_swap_panels_title"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_up_icon_white_24dp"
                    android:contentDescription="@string/om_action_parent_dir"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Selection Mode: [X] [Copiar] [Mover] [Borrar] [Más...] (MT Manager style with ImageButtons matching bottomBarNormal) -->
            <LinearLayout
                android:id="@+id/bottomBarSelection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnSelectionClose"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/close_icon_white_24dp"
                    android:contentDescription="@string/om_action_cancel_selection"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnCopyOpposite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/copy_icon_white_24dp"
                    android:contentDescription="@string/om_action_copy_other_panel_desc"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnMoveOpposite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/move_icon_white_24dp"
                    android:contentDescription="@string/om_action_move_other_panel_desc"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnDeleteSelection"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/delete_icon_white_24dp"
                    android:contentDescription="@string/om_action_delete_selected"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnMoreSelection"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/more_vertical_icon_white_24dp"
                    android:contentDescription="@string/om_more_options"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- MT-Style Navigation Drawer (Sliding 300dp from start) -->
    <LinearLayout
        android:id="@+id/navigationDrawerView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#303030"
        android:orientation="vertical"
        android:fitsSystemWindows="false">

        <!-- Drawer Header -->
        <LinearLayout
            android:id="@+id/layoutDrawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:background="#151515"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_openmanager_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenManager"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Source Edition"
                    android:textColor="#888888"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDrawerSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/settings_icon_white_24dp"
                app:tint="@android:color/white"
                android:contentDescription="@string/om_nav_settings" />
        </LinearLayout>

        <!-- Drawer Content -->
        <ScrollView
            android:id="@+id/drawerScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <!-- Section: Local -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/om_nav_section_local"
                    android:textColor="#888888"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Root Directory Item -->
                <LinearLayout
                    android:id="@+id/drawerItemRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/device_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/om_nav_root_title"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <ProgressBar
                            android:id="@+id/progressRootStorage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:progress="100"
                            android:progressTint="#2196F3" />

                        <TextView
                            android:id="@+id/tvRootStorageStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/om_nav_root_subtitle"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Internal Storage Directory Item -->
                <LinearLayout
                    android:id="@+id/drawerItemInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/sd_card_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/om_nav_internal_storage"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <ProgressBar
                            android:id="@+id/progressInternalStorage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:progress="80"
                            android:progressTint="#2196F3" />

                        <TextView
                            android:id="@+id/tvInternalStorageStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/storage/emulated/0"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Downloads Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemDownloads"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/download_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/om_nav_downloads"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/storage/emulated/0/Download"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Android/data Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemAndroidData"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/directory_icon_white_24dp"
                            app:tint="#42A5F5" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Android/data"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/om_nav_android_data_subtitle"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dynamic User-Added Storages Container -->
                <LinearLayout
                    android:id="@+id/layoutCustomStorages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Add Storage Item (SAF / Document Tree) -->
                <LinearLayout
                    android:id="@+id/drawerItemAddStorage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/add_icon_white_24dp"
                            app:tint="#42A5F5" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_add_storage"
                        android:textColor="#42A5F5"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Section: Tools -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/om_nav_tools"
                    android:textColor="#888888"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- APK Tools / Apktool -->
                <LinearLayout
                    android:id="@+id/drawerItemApktool"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_apktool"
                            app:tint="#4CAF50" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_apktool_tools"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Installed Apps (MT Manager Extractor) -->
                <LinearLayout
                    android:id="@+id/drawerItemInstalledApps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_apps_white_24dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/navigation_installed_apps"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Running Apps (App Manager System) -->
                <LinearLayout
                    android:id="@+id/drawerItemRunningApps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_running_apps_white_24dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/navigation_running_apps"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Text Editor -->
                <LinearLayout
                    android:id="@+id/drawerItemTextEditor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/file_text_icon"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_text_editor"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Remote Manager (FTP Server) -->
                <LinearLayout
                    android:id="@+id/drawerItemFtp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/computer_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_remote_ftp"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Terminal -->
                <LinearLayout
                    android:id="@+id/drawerItemTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/terminal_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_terminal"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Recycle Bin (Papelera de reciclaje) -->
                <LinearLayout
                    android:id="@+id/drawerItemRecycleBin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/delete_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/drawer_item_recycle_bin_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Settings -->
                <LinearLayout
                    android:id="@+id/drawerItemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/settings_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_settings"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:id="@+id/drawerItemAbout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/about_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/om_nav_about"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
