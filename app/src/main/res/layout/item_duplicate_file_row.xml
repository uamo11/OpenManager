<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?selectableItemBackground"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <CheckBox
        android:id="@+id/cbMarkDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#DA3633" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="example_photo.jpg"
            android:textColor="#F0F6FC"
            android:textSize="13.5sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="/storage/emulated/0/DCIM/Camera/..."
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="start" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFileDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="06/11 16:45"
        android:textColor="#8B949E"
        android:textSize="10.5sp"
        android:fontFamily="monospace" />
</LinearLayout>
