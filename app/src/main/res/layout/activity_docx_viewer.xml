<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- WebView Content -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:overScrollMode="never" />

    <!-- Top AppBar Container (Toolbar + SearchBar) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151515"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:background="#151515"
            app:navigationIcon="@drawable/arrow_back_icon_white_24dp"
            app:navigationIconTint="@android:color/white"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark"
            app:subtitleTextColor="#A0A0A0"
            app:titleTextColor="#FFFFFF" />

        <!-- Floating/Docked Search Bar -->
        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#242424"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/search_icon_white_24dp"
                app:tint="#A0A0A0" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/docx_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                tools:text="1 de 5" />

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/om_action_previous"
                android:src="@drawable/arrow_up_icon_white_24dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/om_action_next"
                android:src="@drawable/ic_arrow_downward_24dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnSearchClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/om_close_search"
                android:src="@drawable/close_icon_white_24dp"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Error Layout -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/file_word_icon" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/docx_error_open"
            android:textColor="#E0E0E0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnOpenExternal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/file_item_action_open_with"
            app:backgroundTint="#2E7D32" />
    </LinearLayout>

</FrameLayout>
