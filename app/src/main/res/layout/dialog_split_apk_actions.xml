<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_open_as_apks"
            android:background="@drawable/badge_apks_bg"
            android:padding="8dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSplitApkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSplitApkSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Action 1: AntiSplit (Fusionar en APK único) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionAntiSplit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:text="@string/antisplit_merge"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_mt_merge"
        app:iconTint="#FFB300"
        app:iconGravity="textStart"
        app:backgroundTint="#333333"
        app:strokeColor="#FFB300"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

    <!-- Action 2: Instalar splits -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionInstall"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/install"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:icon="@drawable/ic_open_as_apk"
        app:iconTint="#4CAF50"
        app:iconGravity="textStart"
        app:backgroundTint="#2A2A2A"
        app:cornerRadius="12dp" />

    <!-- Action 3: Ver / Explorar contenido -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionExplore"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/view"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:icon="@drawable/directory_icon_white_24dp"
        app:iconTint="#42A5F5"
        app:iconGravity="textStart"
        app:backgroundTint="#2A2A2A"
        app:cornerRadius="12dp" />

    <!-- Action 4: Firmar archivo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionSign"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/apk_sign"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:icon="@drawable/check_icon_control_normal_24dp"
        app:iconTint="#AB47BC"
        app:iconGravity="textStart"
        app:backgroundTint="#2A2A2A"
        app:cornerRadius="12dp" />

</LinearLayout>
