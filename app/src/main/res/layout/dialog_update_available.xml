<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#262626"
    android:padding="20dp">

    <!-- Header: Icon + Title & Channel Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/download_icon_white_24dp"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_available_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Canal: Release (Estable)" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#383838"
        android:layout_marginBottom="12dp" />

    <!-- Version & File Info Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1F1F1F"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUpdateVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            tools:text="Nueva versión: v1.9.51\nVersión actual: v1.9.50" />

        <TextView
            android:id="@+id/tvUpdateFileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            tools:text="Archivo: OpenManager-v1.9.51-release.apk (34.9 MB)" />
    </LinearLayout>

    <!-- Changelog Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_changelog_label"
        android:textColor="#FFB74D"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollUpdateChangelog"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#1B1B1B"
        android:padding="10dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvUpdateChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            tools:text="Changelog text..." />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#383838"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateDownload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/update_action_download_and_install"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="8dp"
            app:icon="@drawable/download_icon_white_24dp"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:iconPadding="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUpdateLater"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/update_action_later"
                android:textColor="#9E9E9E"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnUpdateGitHub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/update_action_view_on_github"
                android:textColor="#64B5F6"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
