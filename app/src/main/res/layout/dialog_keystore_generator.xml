<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#242424">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_keystore_key"
                app:tint="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keystore_generator_title"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keystore_generator_subtitle"
                    android:textColor="#AAAAAA"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#383838"
            android:layout_marginBottom="14dp" />

        <!-- 1. Destination Directory & File Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_dest_path"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editKeystoreDir"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_file_name"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editKeystoreFileName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="my-release-key.jks"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:singleLine="true" />

        <!-- Formats to Generate -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formatos de clave:"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/cbFormatJks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="KeyStore (.jks / PKCS12) - Estándar"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbFormatBks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="KeyStore BouncyCastle (.bks)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbFormatAosp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Par de claves AOSP (.pk8 + .pem)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. Alias & Passwords -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_alias"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAlias"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="key0"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_password"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editStorePass"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:hint="Mínimo 6 caracteres"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/cbSameKeyPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/keystore_same_password"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutKeyPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_key_password"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editKeyPass"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:hint="Contraseña de la clave privada"
                android:textColorHint="#666666"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 3. Key Size & Validity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_key_size"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgKeySize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp">

            <RadioButton
                android:id="@+id/rbKeySize2048"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="RSA 2048 bits"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbKeySize4096"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="RSA 4096 bits"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_validity_years"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editValidityYears"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="25"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:inputType="number"
            android:singleLine="true" />

        <!-- 4. Certificate Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystore_common_name"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editCommonName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="#333333"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Android"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:singleLine="true" />

        <!-- Advanced Details Toggle -->
        <CheckBox
            android:id="@+id/switchAdvancedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keystore_advanced_details"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layoutAdvancedDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_org_unit"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editOrgUnit"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_org_name"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editOrgName"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_locality"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editLocality"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_state"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editState"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keystore_country"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editCountry"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="#333333"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:maxLength="2"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnCancelKeystore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@android:string/cancel"
                android:textColor="#CCCCCC"
                android:backgroundTint="#3A3A3A" />

            <Button
                android:id="@+id/btnGenerateKeystore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/keystore_generate_btn"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
